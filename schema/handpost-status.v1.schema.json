{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanzir71.github.io/handpost/schema/handpost-status.v1.schema.json",
  "title": "Handpost status file — protocol v1",
  "description": "The snapshot Handpost keeps in handpost.status.json for writers. Normative spec: docs/INBOX_PROTOCOL.md §9.",
  "type": "object",
  "additionalProperties": false,
  "required": ["handpost", "app_version", "generated_at", "alive_until", "timezone", "inbox", "platforms", "upcoming", "recent"],
  "properties": {
    "handpost": { "const": 1 },
    "app_version": { "type": "string" },
    "generated_at": { "$ref": "#/$defs/instant" },
    "alive_until": { "$ref": "#/$defs/instant" },
    "timezone": { "type": "string" },
    "inbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_schedule", "accepts", "max_file_kb", "media_outside_inbox"],
      "properties": {
        "auto_schedule": { "type": "boolean" },
        "accepts": { "type": "array", "items": { "enum": ["md", "json"] } },
        "accepts_versions": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "max_file_kb": { "type": "integer" },
        "media_outside_inbox": { "type": "boolean" }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connected", "status", "handle", "daily_cap", "scheduled_today", "frozen_until", "next_free_slots", "limits"],
        "properties": {
          "connected": { "type": "boolean" },
          "status": { "enum": ["ok", "needs_login", "challenged", "frozen", "not_connected"] },
          "handle": { "type": ["string", "null"] },
          "daily_cap": { "type": "integer", "minimum": 1 },
          "scheduled_today": { "type": "integer", "minimum": 0 },
          "frozen_until": { "oneOf": [{ "$ref": "#/$defs/instant" }, { "const": "manual" }, { "type": "null" }] },
          "next_free_slots": { "type": "array", "items": { "$ref": "#/$defs/instant" } },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_chars", "max_media", "media_kinds", "threads"],
            "properties": {
              "max_chars": { "type": "integer" },
              "max_media": { "type": "integer" },
              "media_kinds": { "type": "array", "items": { "enum": ["image", "video"] } },
              "threads": { "type": "boolean" }
            }
          }
        }
      }
    },
    "upcoming": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platforms", "scheduled_at", "state"],
        "properties": {
          "id": { "type": "string" },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "scheduled_at": { "$ref": "#/$defs/instant" },
          "state": { "type": "string" },
          "preview": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "recent": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "status", "published_at", "url"],
        "properties": {
          "id": { "type": "string" },
          "platform": { "type": "string" },
          "status": { "type": "string" },
          "published_at": { "oneOf": [{ "$ref": "#/$defs/instant" }, { "type": "null" }] },
          "url": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$" }
  }
}
