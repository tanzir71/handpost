{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tanzir71.github.io/handpost/schema/handpost-selectors.v1.schema.json",
  "title": "Handpost selector fix — handpost-selectors/1",
  "description": "Replacement selectors for one platform, written to <Handpost folder>/selectors/proposed/<platform>.json and applied by the owner in Accounts → Selectors. Every slot listed in \"replace\" must also appear in \"slots\". Generated from src/shared/selectors.ts (npm run schema). Spec: docs/SELECTORS.md.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "handpost-selectors/1"
    },
    "platform": {
      "type": "string",
      "enum": [
        "mock",
        "x",
        "linkedin",
        "bluesky",
        "threads",
        "facebook",
        "instagram",
        "tiktok",
        "youtube",
        "pinterest"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "minItems": 1,
        "maxItems": 10
      },
      "propertyNames": {
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9:. _-]+$"
      }
    },
    "replace": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9:. _-]+$"
      },
      "maxItems": 60
    }
  },
  "required": [
    "format",
    "platform",
    "slots"
  ],
  "additionalProperties": false
}
