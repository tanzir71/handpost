{
  "name": "handpost",
  "productName": "Handpost",
  "description": "Local-first desktop scheduler that posts through your own browser and takes posts from Claude or Codex via a folder.",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "overrides": {
    "esbuild": "0.28.1"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsup --watch --onSuccess \\\"cross-env HANDPOST_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\\\"\"",
    "dev:edge": "cross-env HANDPOST_BROWSER=msedge npm run dev",
    "build": "vite build && tsup && tsx scripts/copy-assets.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run tests/unit",
    "contract": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run tests/contract",
    "e2e-lite": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run tests/e2e --no-file-parallelism",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run contract && npm run e2e-lite && npm run fingerprint",
    "capture": "tsx src/main/engine/capture.ts",
    "fingerprint": "tsx scripts/fingerprint.ts",
    "seed": "tsx scripts/seed.ts",
    "website:verify": "node scripts/site-schema.mjs && node scripts/verify-website.mjs",
    "website:browser": "node scripts/verify-website-browser.mjs",
    "format": "prettier --write src tests scripts vite.config.ts vitest.config.ts tsup.config.ts eslint.config.js",
    "format:check": "prettier --check src tests scripts vite.config.ts vitest.config.ts tsup.config.ts eslint.config.js",
    "schema": "tsx scripts/schema.ts",
    "inbox:smoke": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/tsx/dist/cli.mjs scripts/inbox-smoke.ts",
    "browser:info": "tsx scripts/browser-info.ts",
    "icons": "tsx scripts/icons.ts",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "smoke:packaged": "tsx scripts/packaged-smoke.ts",
    "website:shot": "node scripts/site-shot.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "p-queue": "^8.1.0",
    "pino": "^9.7.0",
    "playwright": "^1.54.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@eslint/js": "^9.31.0",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "ajv": "^8.20.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "express": "^5.2.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.525.0",
    "prettier": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.25.2"
  },
  "author": {
    "name": "Tanzir Rahman"
  },
  "homepage": "https://tanzir71.github.io/handpost/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tanzir71/handpost.git"
  }
}
